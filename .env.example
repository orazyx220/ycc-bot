# === Modèle de configuration ===
# Copie ce fichier en ".env" puis remplis les valeurs.
# Le vrai fichier .env ne doit JAMAIS être partagé ni mis sur GitHub.

# Token secret du bot (Developer Portal > onglet Bot > Reset Token)
DISCORD_TOKEN=colle_ton_token_ici

# Application ID (Developer Portal > General Information > Application ID)
CLIENT_ID=colle_ton_application_id_ici

# ID de TON serveur Discord (clic droit sur l'icône du serveur > Copier l'identifiant du serveur)
GUILD_ID=colle_l_id_de_ton_serveur_ici

# Chaîne de connexion MongoDB (MongoDB Atlas > Connect > Drivers)
# Exemple : mongodb+srv://user:motdepasse@cluster0.xxxx.mongodb.net/ycc
MONGODB_URI=colle_ta_chaine_de_connexion_ici
